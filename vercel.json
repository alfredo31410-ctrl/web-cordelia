{
  "version": 2,
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/landings",
      "destination": "https://cordelia-landings.vercel.app/cordelia-landings"
    },
    {
      "source": "/landings/:path*",
      "destination": "https://cordelia-landings.vercel.app/cordelia-landings/:path*"
    },
    {
      "source": "/cordelia-landings-static/:path*",
      "destination": "https://cordelia-landings.vercel.app/cordelia-landings-static/:path*"
    },
    {
      "source": "/logos/:path*",
      "destination": "https://cordelia-landings.vercel.app/logos/:path*"
    }
  ]
}
